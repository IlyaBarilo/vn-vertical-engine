{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "exactOptionalPropertyTypes": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "moduleDetection": "force",
    "noEmit": true,
    "noImplicitAny": false,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022"
  },
  "include": [
    "../engine/autosave-payload.js",
    "../engine/game-protocol.js",
    "../engine/resource-path-policy.js"
  ]
}
